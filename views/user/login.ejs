<% layout("/layouts/boilerplate") %>
<h1 class="col-6 offset-5">Login</h1>
<hr>
<br>
<div class="row mt-3">
    <div class="col-6 offset-3">
        <form action="/login" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input 
                    name="username" 
                    id="username" 
                    type="text" 
                    class="form-control" 
                    required
                />
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input 
                    name="password" 
                    id="password" 
                    type="password" 
                    class="form-control" 
                    required
                />
            </div>
            <br>
            <br>
            <button class="btn btn-success">Login</button>
            <br>
            <br>
            <div class="col-7 offset-4">New User ?  <a href="/signup">Sign UP</a></div>
        </form>
    </div>
</div>